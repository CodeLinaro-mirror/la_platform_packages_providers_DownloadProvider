-        Downloads.Impl.COLUMN_STATUS + " <= '199') AND (" +
-        Downloads.Impl.COLUMN_VISIBILITY + " IS NULL OR " +
-        Downloads.Impl.COLUMN_VISIBILITY + " == '" + Downloads.Impl.VISIBILITY_VISIBLE + "' OR " +
-        Downloads.Impl.COLUMN_VISIBILITY +
